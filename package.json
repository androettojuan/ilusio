{
  "name": "ilusio",
  "version": "0.1.0",
  "description": "CAD paramétrico en el navegador, open source. Boceto con restricciones, extruir, revolución, empalme, lienzos e historial editable.",
  "license": "LGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/androettojuan/ilusio.git"
  },
  "homepage": "https://github.com/androettojuan/ilusio#readme",
  "bugs": {
    "url": "https://github.com/androettojuan/ilusio/issues"
  },
  "keywords": [
    "cad",
    "parametric",
    "opencascade",
    "planegcs",
    "webassembly",
    "three.js"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "postinstall": "bash scripts/copy-wasm.sh",
    "test": "vitest run",
    "test:kernel": "node scripts/test-kernel.mjs && node scripts/test-solver.mjs"
  },
  "dependencies": {
    "@salusoft89/planegcs": "^1.3.0",
    "@types/three": "^0.186.0",
    "opencascade.js": "^2.0.0-beta.b5ff984",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.186.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  }
}
